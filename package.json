{
  "name": "sixtysix",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace app",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace app",
    "start": "npm run start --workspace server",
    "lan": "npm run build --workspace app && npm run start --workspace server",
    "cf:build": "cd app && SIXTYSIX_TARGET=cloudflare SKIP_PRECOMPRESS=1 npm run build && node ../cloudflare/write-headers.mjs",
    "cf:dev": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "wrangler": "^4.160.1"
  }
}
